{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?p=index"
    },
    {
      "source": "/products",
      "destination": "/api/page?p=products"
    },
    {
      "source": "/categories",
      "destination": "/api/page?p=categories"
    },
    {
      "source": "/cart",
      "destination": "/api/page?p=cart"
    },
    {
      "source": "/product",
      "destination": "/api/page?p=product"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/page?p=product&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/g?__h=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/g?__h=robots"
    },
    {
      "source": "/api/health",
      "destination": "/api/g?__h=health"
    },
    {
      "source": "/api/login",
      "destination": "/api/g?__h=login"
    },
    {
      "source": "/api/backup",
      "destination": "/api/g?__h=backup"
    },
    {
      "source": "/api/notify",
      "destination": "/api/g?__h=notify"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "views/**"
    }
  }
}
