# These are PLACEHOLDERS. Put your real values only in Vercel -> Project -> Settings -> Environment Variables.
# Never write your real password in a file that goes to GitHub.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Any long random text (used to sign admin login tokens)
SESSION_SECRET=change-me-to-a-long-random-text

# Added automatically when you connect Upstash Redis from the Vercel Marketplace:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
